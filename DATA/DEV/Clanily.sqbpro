ncoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="130"/><column index="2" value="102"/><column index="3" value="410"/><column index="4" value="78"/><column index="5" value="93"/><column index="6" value="259"/><column index="7" value="63"/><column index="8" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">SELECT LOANS.*,  (SELECT SUM(TRANSACTION_AMOUNT) FROM TRANSACTIONS
WHERE TRANSACTIONS.LOAN_ID = LOANS.LOAN_ID AND TRANSACTION_TYPE = 'Income') AS LOAN_AMOUNT,  (SELECT SUM(ABS(TRANSACTION_AMOUNT)) FROM TRANSACTIONS 
WHERE  TRANSACTIONS.LOAN_ID = LOANS.LOAN_ID AND TRANSACTIONS.TRANSACTION_TYPE = 'Income' ) AS TOTAL_PAID  FROM LOANS WHERE 1 = 1  AND INTERNAL = '0'  AND LOAN_TYPE = 'Borrow' </sql><current_tab id="0"/></tab_sql></sqlb_project>
